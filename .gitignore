# RSOS 2.0 -- Build-System
# Raphael Steffes / Steffes Industries

# --- Alles, was live-build und unsere Skripte erzeugen, gehört nicht ins Repo ---

# live-build Arbeitsverzeichnisse (im Projektwurzelverzeichnis)
/chroot/
/binary/
/cache/
/.build/
/build/
/config/binary
/config/chroot
/config/common
/config/bootstrap
/config/source
/config/.build
/live-image-*
*.hybrid.iso
*.iso
*.squashfs
*.tar
*.tar.gz
*.zsync
*.list
*.packages
*.contents
*.files
*.md5sum
*.sha256sum
*.sha512sum
*.sha1sum
/checksums*
/build.log
/.lb-status
/*.log

# ISO-Ausgabe
/out/

# lokale Toolchain (rootless-Weg)
/.toolchain/
/rootfs/
/isoroot/

# live-build erzeugt sich diese Paketliste selbst (live-boot, live-config,
# live-config-systemd, systemd-sysv) -- nicht ins Repo.
/config/package-lists/live.list.chroot

# live-build verlinkt seine Standardhooks bei jedem `lb config` selbst nach
# config/hooks/ -- absolut auf /usr/share/live/build/hooks. Abschaltbar ist das
# nicht. Unsere eigenen Haken liegen in config/hooks/normal/ und sind durchweg
# 0xxx numeriert, die von live-build gelieferten beginnen bei 1000.
/config/hooks/live/*
/config/hooks/normal/1*
/config/hooks/normal/5*
/config/hooks/normal/8*
/config/hooks/normal/9*

# Editor / System
*~
*.swp
.DS_Store

# Python-Zwischenstaende
__pycache__/
*.pyc
