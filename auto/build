#!/bin/sh
# RSOS -- Bauen.
#
# Wird von `lb build` aufgerufen (live-build laeuft ueber auto/build).
# Laeuft im Projektwurzelverzeichnis.

set -e

cd "$(dirname "$0")/.."

VERSION="$(cat VERSION)"
CODENAME="$(cat CODENAME)"
NAME="RSOS-${VERSION}-${CODENAME}"
DATE="$(date -u +%Y%m%d)"

# Ausgabe gleichzeitig auf den Bildschirm und in build.log -- ein Bau laeuft
# 20 bis 60 Minuten, im Fehlerfall ist build.log die einzige Spur.
#
# Der Exit-Code kommt ueber eine Statusdatei, weil eine Pipeline unter POSIX-sh
# sonst nur den Code von `tee` liefert und ein Fehler unbemerkt bliebe.
rm -f .lb-status
( lb build noauto 2>&1; echo $? > .lb-status ) | tee build.log
rc="$(cat .lb-status 2>/dev/null || echo 1)"
rm -f .lb-status

if [ "${rc}" -ne 0 ]; then
	echo
	echo "Bau fehlgeschlagen (Code ${rc}). Ende von build.log:" >&2
	tail -30 build.log >&2
	exit "${rc}"
fi

# Ergebnis einsammeln
mkdir -p out
for f in ./*.hybrid.iso ./*.iso; do
	[ -e "$f" ] || continue
	mv -v "$f" "out/${NAME}-${DATE}-amd64.hybrid.iso"
done

echo
echo "Fertig. ISO liegt in out/"
ls -lh out/
