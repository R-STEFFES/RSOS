#!/bin/sh
# RSOS 2.0 -- KDE-Plasma-Voreinstellungen
#
# Setzt nur, was ohne Sitzung nicht automatisch entsteht: Anmeldung des
# Live-Benutzers, Standardsitzung, Hintergrundbilder und die deutsche
# Oberflaechensprache. Das eigentliche Plasma-Layout (Panel, Widgets,
# Farbschema) wird NICHT hier erfunden, sondern mit
# scripts/capture-kde-config.sh von einem eingerichteten System abgezogen
# und in config/includes.chroot/etc/skel/.config/ abgelegt -- siehe
# docs/KDE-KONFIGURATION.md.

set -e

# --- Anmeldung des Live-Benutzers an SDDM ---------------------------------
# Wird von Calamares beim Installieren wieder entfernt (shellprocess-Modul),
# damit das installierte System einen normalen Anmeldebildschirm bekommt.
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-rsos-live.conf <<'EOF'
[Autologin]
User=rsos
Session=plasma

[Theme]
Current=breeze
EOF

# --- Standardsitzung -------------------------------------------------------
mkdir -p /var/lib/AccountsService/users
cat > /var/lib/AccountsService/users/rsos <<'EOF'
[User]
Session=plasma
XSession=plasma
Icon=/usr/share/icons/hicolor/scalable/apps/sti-logo.svg
SystemAccount=false
EOF

# --- Hintergrundbilder -----------------------------------------------------
# Die Wandbilder liegen bereits unter /usr/share/backgrounds/rsos/.
# Zusaetzlich als Plasma-Wandbildpaket, damit sie in den Systemeinstellungen
# unter "Hintergrundbilder" auftauchen (nicht nur als Dateien).
# Aufbau wie bei den offiziellen Plasma-Wandbildern: metadata.json plus
# contents/images/<datei> und contents/screenshot.jpg.
mkdir -p /usr/share/wallpapers/RSOS/contents/images
cat > /usr/share/wallpapers/RSOS/metadata.json <<'EOF'
{
    "KPlugin": {
        "Authors": [
            {
                "Name": "Steffes Industries"
            }
        ],
        "Id": "RSOS",
        "License": "GPL-3.0",
        "Name": "RSOS"
    }
}
EOF

# Ein Wandbild aus dem mitgelieferten Satz als Standardpaket-Bild
if [ -e /usr/share/backgrounds/rsos/Poly1-STI.png ]; then
	cp /usr/share/backgrounds/rsos/Poly1-STI.png \
	   /usr/share/wallpapers/RSOS/contents/images/Poly1-STI.png
	if command -v convert >/dev/null 2>&1; then
		convert -resize 400x /usr/share/wallpapers/RSOS/contents/images/Poly1-STI.png \
			/usr/share/wallpapers/RSOS/contents/screenshot.jpg 2>/dev/null || true
	fi
fi

# --- Dunkles Farbschema -----------------------------------------------------
# Raphael wollte ein dunkles System. BreezeDark faerbt Fenster, Leisten, Menues
# und den Sperrbildschirm dunkel mit hellem Text; das Farbschema "Breeze" (ohne
# Zusatz) ist die helle Fassung.
#
# Als Vorgabe fuer neue Nutzer hier, zusaetzlich systemweit in /etc/xdg.
# Vorsicht beim Abziehen des Plasma-Layouts: capture-kde-config.sh kopiert
# kdeglobals vom Testrechner -- Farbschema und Symbolthema danach pruefen.
mkdir -p /etc/skel/.config
cat > /etc/skel/.config/kdeglobals <<'EOF'
[General]
ColorScheme=BreezeDark
Name=RSOS

[Icons]
Theme=RSOS

[KDE]
LookAndFeelPackage=org.kde.breezedark.desktop
SingleClick=false
widgetStyle=Breeze

[Locale]
Country=de_DE
Language=de_DE
MeasureSystem=1
EOF

# Systemweite Vorgabe: greift auch fuer Konten, deren kdeglobals die Eintraege
# nicht enthaelt (etwa den Live-Benutzer, falls /etc/skel nicht kopiert wurde).
cat > /etc/xdg/kdeglobals <<'EOF'
[General]
ColorScheme=BreezeDark

[Icons]
Theme=RSOS

[KDE]
LookAndFeelPackage=org.kde.breezedark.desktop
EOF

# --- Baloo (Dateiindex) im Live-Betrieb nicht noetig, spart Plattenlast ----
mkdir -p /etc/xdg/baloo
cat > /etc/xdg/baloo/baloofilerc <<'EOF'
[Basic Settings]
Indexing-Enabled=false
EOF

exit 0
