#!/bin/sh
# RSOS 2.0 -- Calamares-Branding im Chroot
#
# calamares-settings-debian bringt einen Eintrag "Debian installieren" mit.
# Der wird auf RSOS umgeschrieben. Das Branding selbst liegt schon unter
# /etc/calamares/branding/rsos/ (aus config/includes.chroot).
#
# Der alte Hook der 1.x-Reihe hat live-build selbst gepatcht
# (firmwarelists.sh). Das ist mit live-build 20250505 nicht mehr noetig und
# waere sogar schaedlich -- siehe docs/MIGRATION-1x-2x.md.

set -e

DESKTOP=/usr/share/applications/install-debian.desktop

if [ -e "${DESKTOP}" ]; then
	sed -i -e 's|^Name=.*|Name=RSOS installieren|' \
	       -e 's|^GenericName=.*|GenericName=System auf die Festplatte installieren|' \
	       -e 's|^Icon=.*|Icon=lava-lamp|' \
	       -e 's|^Comment=.*|Comment=RSOS auf diesen Rechner installieren|' \
	       "${DESKTOP}"
fi

# Gleicher Eintrag fuer das Anwendungsmenue unter dem RSOS-Namen
if [ -e /usr/share/applications/calamares.desktop ]; then
	sed -i -e 's|^Name=.*|Name=RSOS installieren|' \
	       -e 's|^Icon=.*|Icon=lava-lamp|' \
	       /usr/share/applications/calamares.desktop
fi

exit 0
