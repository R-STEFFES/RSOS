/*
 * RSOS 2.0 -- Calamares-Stylesheet
 *
 * Wird von Calamares automatisch geladen, wenn es im Branding-Verzeichnis
 * liegt (hier: /etc/calamares/branding/rsos/stylesheet.qss). Es uebersteuert
 * die Qt-Palette der Live-Sitzung.
 *
 * DREI DINGE, DIE HIER ZUSAMMENSPIELEN
 * ------------------------------------
 * 1. Das Hintergrundbild (wallpaper.png) zeichnet Calamares nach eigener
 *    Beschreibung "as the background of every page" -- also hinter den
 *    Inhalt. Eine deckende Farbe auf #mainApp verdeckt es. Deshalb ist die
 *    Inhaltsflaeche hier DURCHSICHTIG. Vorher stand hier ein deckendes Weiss,
 *    dadurch war von Raphaels Bild nichts zu sehen.
 * 2. Die Schrift ist hell (#FAFAF8). Auf dem dunklen Bild ist das lesbar;
 *    vorher war sie schwarz auf weiss, was Raphael beanstandet hat
 *    ("Mach die Schrift weiss und nicht schwarz").
 * 3. Eingabefelder, Knoepfe und Listen bekommen einen halbdurchsichtigen
 *    dunklen Grund, damit sie sich vom Bild abheben, ohne es zu verdecken.
 *
 * Die Seitenleiste (Schrittliste links) laesst sich hier NICHT stylen -- sie
 * hat einen eigenen C++-Delegate; ihre Farben stehen in den style-Werten von
 * branding.desc (SidebarBackground, SidebarText, SidebarTextCurrent).
 *
 * Objektnamen stammen aus dem Beispiel-Stylesheet von Calamares
 * (/usr/share/calamares/branding/default/stylesheet.qss).
 *
 * Markenfarben: Grund #0C0C0C, Weiss #FAFAF8, Cyan #00E5FF
 */

/* --- Inhaltsflaeche: durchsichtig, helle Schrift -------------------------- */
#mainApp {
    background: transparent;
    color: #FAFAF8;
}

#mainApp QLabel,
#mainApp QCheckBox,
#mainApp QRadioButton,
#mainApp QGroupBox,
#mainApp QAbstractButton {
    color: #FAFAF8;
}

/* --- Eingabefelder und Auswahllisten ------------------------------------- */
#mainApp QLineEdit,
#mainApp QPlainTextEdit,
#mainApp QTextEdit,
#mainApp QTextBrowser,
#mainApp QSpinBox,
#mainApp QComboBox,
#mainApp QAbstractItemView {
    background-color: rgba(12, 12, 12, 0.72);
    color: #FAFAF8;
    border: 1px solid rgba(250, 250, 248, 0.35);
    border-radius: 3px;
}

/* Auswahl in Listen (Sprache, Tastatur, Zeitzone, Datentraeger) */
#mainApp QAbstractItemView:item:selected,
#mainApp QAbstractItemView:item:hover {
    background-color: #00E5FF;
    color: #0C0C0C;
}

/* Spaltenkoepfe der Datentraegerliste */
#mainApp QHeaderView::section {
    background-color: rgba(12, 12, 12, 0.85);
    color: #FAFAF8;
    border: none;
    padding: 4px 6px;
}

/* --- Partitionsseite -----------------------------------------------------
 * Calamares' Partitionsmodul bringt eine eigene Ansichtsklasse mit
 * (PartitionView, ein QTreeView). Sie zeichnet ihren Grund AUS DER PALETTE --
 * deshalb steht die dunkle Palette jetzt zusaetzlich in der kdeglobals (siehe
 * config/hooks/normal/0400-rsos-plasma.hook.chroot). Vorher fehlten dort die
 * [Colors:...]-Werte, das Programm bekam die helle Standardpalette, und meine
 * Regel faerbte nur die Schrift: weisse Schrift auf fast weissem Feld.
 *
 * Diese Regeln decken zusaetzlich alles ab, was ueber das Stylesheet
 * erreichbar ist.
 */
#mainApp PartitionView,
#mainApp QTreeView,
#mainApp QListView,
#mainApp QTableView,
#mainApp QAbstractScrollArea {
    background-color: rgba(12, 12, 12, 0.72);
    alternate-background-color: rgba(20, 22, 26, 0.72);
    color: #FAFAF8;
}

#mainApp PartitionView::item:selected,
#mainApp QTreeView::item:selected,
#mainApp QListView::item:selected {
    background-color: #00E5FF;
    color: #0C0C0C;
}

/* --- Bildlaufflächen (Partitionsseite) -----------------------------------
 * WICHTIG: Der Viewport einer QScrollArea ist ein eigenes Kindfenster und wird
 * von der Regel für das Elternelement NICHT erfasst -- er nimmt seine Farbe aus
 * der Palette. Genau dieser Bereich war auf der Partitionierungsseite fast
 * weiss: die beiden Auswahlpunkte "Festplatte loeschen" und "Manuelle
 * Partitionierung" standen in weisser Schrift darauf. Im laufenden Installer
 * (kopfloser QEMU-Lauf, Bildschirmfoto) nachgesehen.
 */
#mainApp QScrollArea > QWidget#qt_scrollarea_viewport,
#mainApp QAbstractScrollArea > QWidget#qt_scrollarea_viewport,
#mainApp QScrollArea QWidget#qt_scrollarea_viewport > QWidget {
    background-color: rgba(12, 12, 12, 0.72);
    color: #FAFAF8;
}

/* --- Schaltflaechen ------------------------------------------------------ */
#mainApp QPushButton {
    background-color: rgba(12, 12, 12, 0.72);
    color: #FAFAF8;
    border: 1px solid rgba(250, 250, 248, 0.35);
    border-radius: 3px;
    padding: 6px 16px;
}

#mainApp QPushButton:hover {
    background-color: #00E5FF;
    color: #0C0C0C;
    border-color: #00E5FF;
}

#mainApp QPushButton:disabled {
    color: rgba(250, 250, 248, 0.45);
    border-color: rgba(250, 250, 248, 0.18);
}

/* --- Seitenleiste: dunkler Grund (Schrittfarben kommen aus branding.desc) - */
#sidebarApp {
    background-color: #0C0C0C;
}

/* --- Fortschrittsbalken in Cyan ------------------------------------------ */
#mainApp QProgressBar {
    background-color: rgba(12, 12, 12, 0.72);
    color: #FAFAF8;
    border: 1px solid rgba(250, 250, 248, 0.35);
    border-radius: 3px;
}

#mainApp QProgressBar::chunk {
    background-color: #00E5FF;
}

/* --- Bildlaufleisten ----------------------------------------------------- */
#mainApp QScrollBar:vertical,
#mainApp QScrollBar:horizontal {
    background-color: rgba(12, 12, 12, 0.45);
    border: none;
}

#mainApp QScrollBar::handle:vertical,
#mainApp QScrollBar::handle:horizontal {
    background-color: rgba(250, 250, 248, 0.35);
    border-radius: 3px;
}
